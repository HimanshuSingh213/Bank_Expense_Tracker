MONGODB_URI=
APP_URL=http://localhost:3000

# Optional statement password (DOB DDMMYYYY / mobile digits).
# If provided, statement imports will try this automatically before prompting.
STATEMENT_PASSWORD=

# --- Local AI (all optional; features stay off without these) --------------
# Tier 1 (category suggestions) runs via transformers.js on CPU with no env
# config. Set to "off" to disable it entirely.
AI_CATEGORY_SUGGESTIONS=


# Tier 2 (reasoning features) talks to a locally installed Ollama:

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=lfm2.5-thinking:1.2b
